{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "lib",
		"rootDir": "src",
		"declaration": false,
		"sourceMap": false,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/client"]
}
